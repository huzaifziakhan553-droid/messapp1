# MessMate Environment Configuration

# Database URL:
# For SQLite (default local installation):
DATABASE_URL=sqlite:///messmate.db
# For PostgreSQL (production deployment):
# DATABASE_URL=postgresql+psycopg2://user:password@hostname:5432/messmate

# Application Settings
MESS_NAME="Hostel Mess - Room 8"
CURRENCY=PKR
CURRENCY_SYMBOL=Rs.

# Default Admin Credentials (Used on first database initialization only)
DEFAULT_ADMIN_USERNAME=huzaifa
DEFAULT_ADMIN_PASSWORD=AdminSecurePass123!
DEFAULT_ADMIN_NAME="Huzaifa (Admin)"

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# WhatsApp Cloud API (Optional - Official WhatsApp Business Platform)
# Leave blank to use shareable WhatsApp Web/Mobile links
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_RECIPIENT_GROUP_ID=

